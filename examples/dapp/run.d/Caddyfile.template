{
  # Caddy's private control API lets the guest helper read its TLS root CA.
  admin caddy-in-constrained-attestation-generator-network:2019
}


attestation-endpoint.api.mydapp.midnight.io {
	# Bind to all network interfaces
	bind 0.0.0.0
	
	root * /srv
	
	handle_path /tee_attestation* {
		reverse_proxy attestation:8000
	}

	file_server

	{{ATTESTATION_TLS}}
}

api.mydapp.midnight.io {
	# Bind to all network interfaces
	bind 0.0.0.0

	{{APP_TLS}}

	# Reverse proxy to the service
	reverse_proxy {$APP_UPSTREAM}
}

# Forward the host's attested proxy requests to the private app network.
http://:8080 {
	reverse_proxy {$APP_UPSTREAM}
}
