#!/bin/bash

set -e
set -o pipefail
set -x

cd /root/run.d

tls_mode=""
if [ -f ".temenos-tls-mode" ]; then
    tls_mode="$(cat .temenos-tls-mode)"
else
    tls_mode="${TEMENOS_TLS_MODE:-}"
fi
tls_mode="${tls_mode:-internal}"
certs_dir="./certs"
if [ "$tls_mode" = "azure_vault" ]; then
    certs_dir="${TEMENOS_TLS_CERTS_DIR:-/run/temenos/tls}"
    export TEMENOS_TLS_CERTS_DIR="$certs_dir"
fi
install -d -m 0700 "$certs_dir"

validate_azure_keyvault_name() {
    name="$1"
    if [ "${#name}" -lt 3 ] || [ "${#name}" -gt 24 ]; then
        echo "Invalid Azure Key Vault name: $name" >&2
        exit 1
    fi
    case "$name" in
        [abcdefghijklmnopqrstuvwxyz]*[abcdefghijklmnopqrstuvwxyz0123456789]) ;;
        *)
            echo "Invalid Azure Key Vault name: $name" >&2
            exit 1
            ;;
    esac
    case "$name" in
        *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|*--*)
            echo "Invalid Azure Key Vault name: $name" >&2
            exit 1
            ;;
    esac
}

validate_azure_keyvault_secret_name() {
    name="$1"
    if [ -z "$name" ] || [ "${#name}" -gt 127 ]; then
        echo "Invalid Azure Key Vault secret name: $name" >&2
        exit 1
    fi
    case "$name" in
        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-]*)
            echo "Invalid Azure Key Vault secret name: $name" >&2
            exit 1
            ;;
    esac
}

fetch_azure_vault_tls_certs() {
    if [ -f "$certs_dir/fullchain.pem" ] && [ -f "$certs_dir/privkey.pem" ]; then
        return
    fi

    keyvault_name="${TEMENOS_TLS_KEYVAULT_NAME:-}"
    if [ -z "$keyvault_name" ]; then
        keyvault_name="$(curl -fsS -H Metadata:true "http://169.254.169.254/metadata/instance/compute/tagsList?api-version=2021-02-01" | python3 -c 'import json,sys; data=json.load(sys.stdin); tags=data.get("tagsList", data) if isinstance(data, dict) else data; print(next((tag.get("value", "") for tag in tags if tag.get("name") == "temenos_tls_keyvault_name"), ""), end="")' || true)"
    fi
    if [ -z "$keyvault_name" ]; then
        echo "Missing Azure Key Vault name for azure_vault TLS mode" >&2
        exit 1
    fi
    validate_azure_keyvault_name "$keyvault_name"

    fullchain_secret="${TEMENOS_TLS_FULLCHAIN_SECRET:-temenos-tls-fullchain-pem}"
    privkey_secret="${TEMENOS_TLS_PRIVKEY_SECRET:-temenos-tls-privkey-pem}"
    validate_azure_keyvault_secret_name "$fullchain_secret"
    validate_azure_keyvault_secret_name "$privkey_secret"

    xtrace_was_on=0
    case "$-" in
        *x*)
            xtrace_was_on=1
            set +x
            ;;
    esac

    tmp_dir="$(mktemp -d)"
    fetch_secret() {
        name="$1"
        curl -fsS \
            -H "Authorization: Bearer $token" \
            "https://${keyvault_name}.vault.azure.net/secrets/${name}?api-version=2025-07-01" \
            | python3 -c 'import json,sys; print(json.load(sys.stdin)["value"], end="")'
    }

    attempt=1
    while [ "$attempt" -le 60 ]; do
        if token="$(curl -fsS -H Metadata:true "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net" | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"], end="")')" \
            && fetch_secret "$fullchain_secret" > "$tmp_dir/fullchain.pem" \
            && fetch_secret "$privkey_secret" > "$tmp_dir/privkey.pem"; then
            break
        fi

        if [ "$attempt" -eq 60 ]; then
            rm -rf "$tmp_dir"
            if [ "$xtrace_was_on" -eq 1 ]; then
                set -x
            fi
            echo "Failed to fetch TLS certificate secrets from Azure Key Vault: $keyvault_name" >&2
            exit 1
        fi

        attempt=$((attempt + 1))
        sleep 5
    done

    install -d -m 0700 "$certs_dir"
    install -m 0644 "$tmp_dir/fullchain.pem" "$certs_dir/fullchain.pem"
    install -m 0600 "$tmp_dir/privkey.pem" "$certs_dir/privkey.pem"
    rm -rf "$tmp_dir"

    if [ "$xtrace_was_on" -eq 1 ]; then
        set -x
    fi
}

if [ "$tls_mode" = "azure_vault" ]; then
    fetch_azure_vault_tls_certs
fi

tls_directive() {
    name="$1"
    named_cert="$certs_dir/$name/fullchain.pem"
    named_key="$certs_dir/$name/privkey.pem"
    common_cert="$certs_dir/fullchain.pem"
    common_key="$certs_dir/privkey.pem"

    case "$tls_mode" in
        internal)
            echo "tls internal"
            ;;
        azure_vault)
            if [ -f "$named_cert" ] && [ -f "$named_key" ]; then
                echo "tls /certs/$name/fullchain.pem /certs/$name/privkey.pem"
            elif [ -f "$common_cert" ] && [ -f "$common_key" ]; then
                echo "tls /certs/fullchain.pem /certs/privkey.pem"
            else
                echo "Missing Azure Vault mounted TLS certificate/key for $name" >&2
                exit 1
            fi
            ;;
        *)
            echo "Unsupported TEMENOS_TLS_MODE: $tls_mode" >&2
            exit 1
            ;;
    esac
}

site_host() {
    awk '
        /^[[:space:]]*#/ || NF == 0 { next }
        $1 == "}" { depth--; next }
        depth == 0 && NF >= 2 && $NF == "{" && $1 != "{" { print $1 }
        $NF == "{" { depth++ }
    ' Caddyfile.template | sed -n "$1p"
}

attestation_tls="$(tls_directive attestation)"
app_tls="$(tls_directive api)"
attestation_host="$(site_host 1)"
app_host="$(site_host 2)"
if [ -z "$attestation_host" ] || [ -z "$app_host" ]; then
    echo "Could not extract attestation/api hostnames from Caddyfile.template" >&2
    exit 1
fi
if [ "$attestation_tls" = "tls internal" ]; then
    tls_evidence_mode="internal"
else
    tls_evidence_mode="spki"
fi

cat > .guest-attestation.env <<EOF
TEMENOS_TLS_MODE=$tls_mode
TEMENOS_TLS_EVIDENCE_MODE=$tls_evidence_mode
TEMENOS_ATTESTATION_TLS_HOST=$attestation_host
TEMENOS_APP_TLS_HOST=$app_host
TEMENOS_CADDY_CONNECT_HOST=caddy-in-constrained-attestation-generator-network
TEMENOS_CADDY_CONNECT_PORT=443
EOF

sed \
    -e "s|{{ATTESTATION_TLS}}|$attestation_tls|g" \
    -e "s|{{APP_TLS}}|$app_tls|g" \
    Caddyfile.template > Caddyfile.generated

docker compose up -d
